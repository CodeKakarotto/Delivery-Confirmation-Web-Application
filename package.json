{
  "name": "michaels-flowers-delivery-confirmation",
  "version": "0.1.0",
  "private": true,
  "description": "Michael's Flowers mobile delivery confirmation prototype (Cloudflare Workers + D1 + React).",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev:api": "wrangler dev --port 8787",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build:web": "vite build --config frontend/vite.config.ts",
    "preview:web": "vite preview --config frontend/vite.config.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seed/demo-seed.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "test": "node --disable-warning=ExperimentalWarning --import ./frontend/test/register-tsx.mjs --test --test-reporter=spec \"worker/test/**/*.test.ts\" \"frontend/test/**/*.test.tsx\"",
    "typecheck": "tsc -p worker/tsconfig.json && tsc -p worker/test/tsconfig.json && tsc -p frontend/tsconfig.json && tsc -p frontend/test/tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build:web"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "@types/node": "^25.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.2",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
